      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "18.3.3",
    "electron": "42.11.4",
    "react": "18.3.1",
    "typescript": "5.4.5",
    "vitest": "4.1.11",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
