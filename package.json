{
  "name": "vela-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Base común de las aplicaciones Vela: temas, IPC y logger",
  "author": {
    "name": "Iván Ros",
    "email": "it@tcgfactory.com"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./theme": "./src/theme/index.ts",
    "./logger": "./src/logger/index.ts",
    "./ipc": "./src/ipc/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
