{
  "name": "vela-kit",
  "version": "0.3.0",
  "private": true,
  "description": "Base común de las aplicaciones Vela: temas, IPC, logger, comandos, CSP, SQLite, ventana y UI",
  "author": {
    "name": "Iván Ros",
    "email": "it@tcgfactory.com"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./theme": "./src/theme/index.ts",
    "./theme/themes": "./src/theme/themes/index.ts",
    "./logger": "./src/logger/index.ts",
    "./ipc": "./src/ipc/index.ts",
    "./commands": "./src/commands/index.ts",
    "./security": "./src/security/index.ts",
    "./ui": "./src/ui/index.ts",
    "./storage": "./src/storage/index.ts",
    "./window": "./src/window/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
